rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Per-user data: profiles, scans, settings — everything under users/{uid}
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Referral codes (readable by signed-in users so invites can be matched)
    match /referrals/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }
    // Research data sharing — write-only (never readable from the client)
    match /research_scans/{entry} {
      allow create: if request.auth != null;
      allow read: if false;
    }
    // Scan feedback votes + "Report a problem" — write-only
    match /feedback/{entry} {
      allow create: if request.auth != null;
      allow read: if false;
    }
  }
}
